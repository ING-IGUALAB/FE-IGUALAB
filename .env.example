# URL base del backend de Igualab.
# Desarrollo local:
VITE_API_URL=http://localhost:8000

# Producción (ejemplo — ajusta al dominio real del despliegue):
# VITE_API_URL=https://api-igualab.dominio.com

# NOTA: cualquier variable VITE_* se incrusta en el bundle y es visible en el
# navegador. No coloques aquí tokens, contraseñas ni secretos.
